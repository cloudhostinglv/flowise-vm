# Flowise per-client .env — TEMPLATE. Copy to .env and fill in.
# The real .env is gitignored and injected per-client at provision time
# (see autoinstall-snippet.yaml). Never commit a filled-in .env.
#
# All *_SECRET / *_OVERWRITE values below MUST be unique per VM. Generate with:
#   openssl rand -hex 32

# ---- Public identity / TLS ----
# Client subdomain. DNS must point here; Caddy gets a cert for it automatically.
DOMAIN=

# ---- avots.ai backend (this client's OWN key) ----
# Used by seed-credential.sh to create the ChatOpenAI (openAIApi) credential.
# In Flowise, the ChatOpenAI node's Base Path is set to the avots base URL (see README).
AVOTS_API_KEY=av_mcp_REPLACE_ME
AVOTS_BASE_URL=https://api.avots.ai/openai/v1

# ---- First-boot admin account (Flowise v3 Passport auth) ----
# seed-credential.sh registers this admin via POST /api/v1/account/register.
ADMIN_EMAIL=admin@REPLACE_ME
ADMIN_NAME=Administrator
ADMIN_PASSWORD=REPLACE_ME_strong_password

# ---- Encryption key for stored credentials ----
# Stable per-VM key so credentials encrypted at provision time stay decryptable
# (and a pre-encrypted credential could be DB-seeded portably). openssl rand -hex 32
FLOWISE_SECRETKEY_OVERWRITE=

# ---- JWT / session / token secrets (v3 auth). openssl rand -hex 32 each ----
JWT_AUTH_TOKEN_SECRET=
JWT_REFRESH_TOKEN_SECRET=
TOKEN_HASH_SECRET=
EXPRESS_SESSION_SECRET=
